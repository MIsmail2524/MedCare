# Required in production: long random secret (e.g. `openssl rand -hex 32`).
APP_SECRET=
# HTTPS deployments: keep true (enables Secure/__Host- cookies and HSTS).
COOKIE_SECURE=true
# Number of reverse proxies in front of the app (1 behind a typical load balancer).
TRUST_PROXY=1
PORT=8080
DATABASE_PATH=/data/medcare.db
# Optional bootstrap administrator (created once if the email does not exist).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Public demo account (set SEED_DEMO=false to disable).
SEED_DEMO=true
DEMO_PASSWORD=MedCare-Demo-2026
ALLOW_REGISTRATION=true
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
# Optional: Claude-powered plain-language explanations (server-side only).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EXPLAINER=true
